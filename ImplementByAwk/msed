#So "{="       =>  print("{");$0="="
#So "s{x{y{g"  =>  No change.
/{/{
	if ($0 ~ "\v{"){
		while($0 ~ "\v{"){
			k = match($0, "\\$-[0-9]+")
			if (k != 0){
				x = substr($0, 1, k+1)
				y = substr($0, k+2, length($0)-k-1)
				$0 = x "\v" y
			}
			m = match($0, "\v{")
