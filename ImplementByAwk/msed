			c = substr(b, 1, m)
			d = substr(b, m+1, length(b)-m)
			gsub("\a", "\\\\", a)
			gsub("\a", "\\\\", c)
			gsub("\f", "\\;", a)
			gsub("\f", "\\;", c)
			print a c
			$0 = "\v" d
		}
	}
}

